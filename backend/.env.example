# AWS configuration (no credentials belong here)
AWS_PROFILE=research-agent
AWS_REGION=us-east-2

# DynamoDB tables and vector index
DYNAMODB_CORPORA_TABLE=research-agent-corpora
DYNAMODB_CHUNKS_TABLE=research-agent-chunks
DYNAMODB_VECTOR_INDEX=embedding-index

# Amazon Bedrock models
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_GENERATION_MODEL_ID=us.amazon.nova-2-lite-v1:0
