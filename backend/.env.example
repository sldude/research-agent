# Amazon RDS for PostgreSQL connection info
DB_HOST=your-instance.xxxxxxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=research_agent
DB_USER=research_app
DB_PASSWORD=replace-with-your-database-password

# Amazon Bedrock embedding configuration (no credentials belong here)
AWS_PROFILE=research-agent
AWS_REGION=us-east-2
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
